<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.sirius-messages-watch</string>

  <!-- 30秒ごとに messages.mjs --watch を実行。授業時間帯でも受信箱の件数が前回と同じなら exit 3 で即終了（ブラウザ無し）。英語科目（時間割の 02el…）の授業時間帯
       （開始15分前〜終了30分後）だけ Sakai メッセージを取得し、新着ならデスクトップ通知＋科目フォルダへ保存。
       時間帯の外ではスクリプトが即終了する。時間帯外の新着は fetch-all（定期取得）が拾う。 -->
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__INSTALL_DIR__/messages.mjs</string>
    <string>--watch</string>
  </array>

  <key>StartInterval</key>
  <integer>30</integer>

  <key>RunAtLoad</key>
  <false/>

  <key>WorkingDirectory</key>
  <string>__INSTALL_DIR__</string>

  <key>StandardOutPath</key>
  <string>__HOME__/.local/share/sirius-fetch/messages-watch.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.local/share/sirius-fetch/messages-watch.err.log</string>
</dict>
</plist>
